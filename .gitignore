# Local scan evidence can disclose paths, timestamps, and wallet-related metadata.
/artifacts/
**/wallet-scan-reports*/
**/crypto-scan-reports*/
**/CryptoScan*/
*.csv
*.partial.csv
*.scanstate
*.scanjournal
*.log
scan-launch-status*.json

# Machine-specific launch, installation, and screenshot helpers.
/Capture-ScanConsole.ps1
/Close-CompletedScan.ps1
/Install-LocalPackage.ps1
/Launch-CDriveScan.ps1
/Start-CDriveScan.ps1
/Stop-ActiveScan.ps1
/Iniciar-Analisis*.cmd

# Locally compiled assemblies and release archives are generated by the build.
/CryptoBip39Inspector.dll
/CryptoMnemonicScanner*.dll
/dist/*.zip

# Locally generated benchmark snapshots.
/tests/scale-results.json
/tests/scale-before-*.json
/tests/parallel-results.json

# Common development outputs.
**/bin/
**/obj/
**/TestResults/
/.vs/
*.user
*.suo
